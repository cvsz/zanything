ZANYTHING_ENV=production
ZANYTHING_LOG_LEVEL=INFO
ZANYTHING_ALLOWED_ORIGINS=["http://localhost:8080"]
ZANYTHING_HOST=0.0.0.0
ZANYTHING_PORT=8080

# Production authentication is fail-closed. Configure at least one real
# authentication mechanism and remove all development/demo credentials.
ZANYTHING_ALLOW_ANONYMOUS=false
ZANYTHING_JWT_SECRET_KEY=
ZANYTHING_SERVICE_ACCOUNT_API_KEYS={}

# OIDC
# ZANYTHING_OIDC_ISSUER=https://identity.example.com/
# ZANYTHING_OIDC_AUDIENCE=zanything
# ZANYTHING_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json

# Cloudflare Access
# ZANYTHING_CLOUDFLARE_ACCESS_ENABLED=true
# ZANYTHING_CLOUDFLARE_ACCESS_ISSUER=https://example.cloudflareaccess.com
# ZANYTHING_CLOUDFLARE_ACCESS_AUDIENCE=
# ZANYTHING_CLOUDFLARE_ACCESS_JWKS_URI=https://example.cloudflareaccess.com/cdn-cgi/access/certs

# Persistence
# ZANYTHING_DATABASE_URL=postgresql+asyncpg://user:password@localhost/zanything

# Provider credentials must be injected securely.
